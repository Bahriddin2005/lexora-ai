# ---- Backend ----
ENV=dev
DATABASE_URL=postgresql+asyncpg://lexora:lexora@localhost:5432/lexora
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# AI: gemini | fake | none   (fake = deterministic answers, no API key needed)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
AI_PUBLISH_THRESHOLD=0.6

# inline = jobs run inside the API process (dev); celery = separate worker (docker compose / prod)
TASKS_MODE=inline

# local | s3 (MinIO/AWS)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=lexora
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
